# Copy to .env — Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the app is served from. Used to build email asset URLs and CTA links.
#
# Agreed with Salomeh 2026-07-27: the app lives at the ROOT of the subdomain.
# joinalyne.com stays the Wix landing page and waitlist. There is no /app path.
#
# Until the subdomain's DNS is live, point this at the Vercel branch alias
# (https://alyne-git-main-alyne-s-projects.vercel.app) or email images 404.
APP_URL=https://app.joinalyne.com

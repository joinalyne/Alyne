{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/send-match-email.ts": {
      "includeFiles": "emails/**"
    },
    "api/send-notifications.ts": {
      "includeFiles": "emails/**"
    }
  },
  "crons": [
    {
      "path": "/api/send-notifications",
      "schedule": "*/5 * * * *"
    }
  ]
}
